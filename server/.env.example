# ===================================================================
# KADR (کادر) - Configuration & API Keys
# ===================================================================

# Port for backend server (default: 5000)
PORT=5000

# -------------------------------------------------------------------
# The Movie Database (TMDB) API
# Get your Read Access Token at: https://www.themoviedb.org/settings/api
# Used for real-time movie & TV metadata, posters, backdrops, cast, & recommendations.
# -------------------------------------------------------------------
TMDB_API_READ_ACCESS_TOKEN=

# -------------------------------------------------------------------
# Open Movie Database (OMDb) API (Optional for IMDb ratings)
# Get a free key at: http://www.omdbapi.com/apikey.aspx
# -------------------------------------------------------------------
OMDB_API_KEY=

# -------------------------------------------------------------------
# Optional LLM Provider Configuration
# KADR has a built-in deterministic Persian NLP & ranking engine.
# If you wish to attach an external OpenAI/DeepSeek-compatible LLM endpoint:
# -------------------------------------------------------------------
# LLM_API_KEY=
# LLM_API_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
